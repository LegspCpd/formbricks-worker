{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formbricks-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // OpenNext 的中间件打包器刻意不压缩（它需要在产物上做字符串替换），所以
  // `.open-next/middleware/handler.mjs` 里会带着 node_modules 的未压缩源码，动辄上百万行。
  // 交给 wrangler 在最后打包时压缩，能显著减小上传体积（Workers 有 3 MiB / 10 MiB 的压缩体积上限）。
  // keep_names 默认为 true，压缩后类名/函数名仍会保留。
  "minify": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "formbricks_cache_kv"
    },
    {
      "binding": "TAG_CACHE_KV",
      "id": "formbricks_tag_cache_kv"
    },
    {
      "binding": "MEMORY_CACHE_KV",
      "id": "formbricks_memory_cache_kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_R2",
      "bucket_name": "formbricks-storage"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "formbricks-storage"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "formbricks-worker"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "formbricks-jobs"
      }
    ]
  },
  // 可选配置：
  // - 如果使用 Neon + Hyperdrive，取消下面的注释并填入你的 Hyperdrive id
  // - 如果不需要 Hyperdrive，保持注释状态即可
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "your_hyperdrive_id"
  //   }
  // ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
