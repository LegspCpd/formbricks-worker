# Never upload local secrets. The build reads every value from Vercel's environment
# variables; this file would otherwise shadow WEBAPP_URL/BETTER_AUTH_URL/NEXTAUTH_URL
# with the forms.legspcpd.top values and bake the wrong absolute URLs into the bundle.
# apps/web/.env is a symlink to the root .env and is loaded by Next.js from the app
# directory, so it must be excluded too.
.env
apps/web/.env
**.env.local
**.env.production

# Local scratch/debug files
.tmp-*
*.log

# Version control + editor
.git
.github
.vscode

# Build artifacts and caches (all regenerated by the Vercel build)
.turbo
**/.turbo
**/.next
**/.open-next
**/dist
**/coverage
node_modules
**/node_modules

# Local-only tooling that is irrelevant to a Vercel build
apps/web/cloudflare
tests
**/playwright-report
**/test-results